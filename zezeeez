-- Вирус-скрипт с киком (полный экран + автоматический выброс)
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LP = Players.LocalPlayer

if CoreGui:FindFirstChild("VirusScreen") then
    CoreGui.VirusScreen:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "VirusScreen"
ScreenGui.Parent = CoreGui
ScreenGui.IgnoreGuiInset = true
ScreenGui.ResetOnSpawn = false

local texts = {
    "you are loser",
    "fatass nigga",
    "XD"
}

local labels = {}
for i = 1, 80 do
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0, 200, 0, 40)
    lbl.BackgroundTransparency = 1
    lbl.Text = texts[math.random(1, #texts)]
    lbl.TextColor3 = Color3.new(math.random(), math.random(), math.random())
    lbl.TextSize = math.random(20, 60)
    lbl.Font = Enum.Font.GothamBold
    lbl.Position = UDim2.new(math.random(), 0, math.random(), 0)
    lbl.Parent = ScreenGui
    table.insert(labels, lbl)
end

-- Анимация
local function update()
    for _, lbl in ipairs(labels) do
        local newX = math.clamp(lbl.Position.X.Scale + (math.random(-5,5)/100), 0, 1)
        local newY = math.clamp(lbl.Position.Y.Scale + (math.random(-5,5)/100), 0, 1)
        lbl.Position = UDim2.new(newX, 0, newY, 0)
        lbl.TextColor3 = Color3.new(math.random(), math.random(), math.random())
        if math.random(1,10) == 1 then
            lbl.Text = texts[math.random(1, #texts)]
        end
        lbl.TextSize = math.random(20,60)
    end
end

local connection = RunService.RenderStepped:Connect(update)

-- Защита от удаления
task.spawn(function()
    while true do
        task.wait(0.1)
        if not ScreenGui.Parent then
            ScreenGui.Parent = CoreGui
        end
    end
end)

-- Таймер на кик через 10 секунд
task.delay(10, function()
    connection:Disconnect()
    ScreenGui:Destroy()
    if LP then
        LP:Kick("Exploiting detected")
    else
        game:Shutdown()
    end
end)

-- Альтернативный кик по нажатию Insert (для досрочного выхода)
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Insert then
        connection:Disconnect()
        ScreenGui:Destroy()
        if LP then
            LP:Kick("Exploiting detected")
        else
            game:Shutdown()
        end
    end
end)
